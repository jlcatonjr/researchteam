        },
        "legacy_exceptions": {
          "type": "string",
          "minLength": 1,
          "description": "a path under rule 1.6: relative to the study's folder, or repo:-rooted"
        },
        "attribute_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "format",
        "tiers",
        "counted_tiers",
        "not_established_tier"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "plugin"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "required": [
              "reader"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
