      "additionalProperties": false,
      "required": [
        "code",
        "label"
      ]
    },
    "LevelSet": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "label": {
          "type": "string"
        },
        "levels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Level"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "levels"
      ]
    },
    "Plugin": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "a path under rule 1.6: relative to the study's folder, or repo:-rooted"
        },
        "attr": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "attr",
        "version"
      ]
    },
    "Bucketer": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "table"
            },
            "table": {
              "type": "string",
              "minLength": 1,
              "description": "a path under rule 1.6: relative to the study's folder, or repo:-rooted"
            },
            "match": {
              "enum": [
                "first",
                "all"
              ]
            },
            "fallback": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "table"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "period"
            }
          },
          "additionalProperties": false,
          "required": [
