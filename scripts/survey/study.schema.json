          "additionalProperties": false,
          "required": [
            "kinds",
            "analysis"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "enumerations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "label": {
            "type": "string"
          },
          "window": {
            "type": "object",
            "properties": {
              "from": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "to": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ]
          },
          "seeds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "query_plan": {
            "type": "string",
            "minLength": 1,
            "description": "a path under rule 1.6: relative to the study's folder, or repo:-rooted"
          },
          "log": {
            "type": "string",
            "minLength": 1,
            "description": "a path under rule 1.6: relative to the study's folder, or repo:-rooted"
          },
          "stopping_rule": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "saturation",
                  "exhaustive-corpus",
                  "closed-list",
                  "legacy-unrecorded"
                ]
              },
              "rounds_without_new": {
                "type": "integer",
                "minimum": 1
              },
              "min_new_share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "saturation"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "required": [
                    "rounds_without_new",
                    "min_new_share"
                  ]
                }
              }
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "window",
          "log",
          "stopping_rule"
        ]
      },
      "minItems": 1
    },
    "evidence": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "a path under rule 1.6: relative to the study's folder, or repo:-rooted"
        },
        "format": {
