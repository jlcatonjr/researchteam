# Ignore all files in tmp (plan artifacts, logs, and local scratch)
tmp/

# agentteams update/migration backups (local rollback artifacts)
.github/agents/.agentteams-backups/

# Python package build and virtual environment artifacts
.venv/
*.egg-info/
dist/
build/
__pycache__/
*.pyc

# Archival update backups (any location) — never tracked (update-policy)
**/.agentteams-backups/

# agentteams local artifacts — do not commit
.agentteams-backups/
.agentteams-fleet/
bridge-*.report.md
**/bridge-*.report.md
*.bak
*.bak.*
*.prelabel.bak
.DS_Store

# researchteam layer-1 union temp descriptor (created+removed during agentteams merge)
.rt-descriptor-*.json

# Per-project literature library — optional out-of-band full-text corpus + bulky vector store are
# regenerable and never committed (the durable pins are literature.jsonl + *.provenance.json).
# The base index (literature.jsonl / term-vectors.jsonl / library-manifest.json) IS committed.
# See docs/literature-library-protocol.md.
**/references/library/corpus/*.txt
**/references/library/vectors/store/

# agentteams code & API index (F-CODEIDX) — a gitignored local cache (manifest.json + per-kind
# partitions) that embeds machine-specific resolved paths/versions; regenerable, NEVER committed and
# NEVER drift-tracked. Both patterns are load-bearing: the root-anchored one, and the `**/` one that
# matches the actual cache location `.github/agents/references/code-index/`. Query-time staleness keeps
# it fresh. See docs/retrieval-surfaces.md and docs/code-index-integration-plan.md.
references/code-index/
**/references/code-index/
