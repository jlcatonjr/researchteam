# Ignore all files in tmp (plan artifacts, logs, and local scratch)
tmp/

# agentteams update/migration backups (local rollback artifacts)
.github/agents/.agentteams-backups/

# Python package build and virtual environment artifacts
.venv/
*.egg-info/
dist/
build/
__pycache__/
*.pyc

# Archival update backups (any location) — never tracked (update-policy)
**/.agentteams-backups/

# agentteams local artifacts — do not commit
.agentteams-backups/
.agentteams-fleet/
bridge-merge.report.md
*.bak
*.bak.*
*.prelabel.bak
.DS_Store
